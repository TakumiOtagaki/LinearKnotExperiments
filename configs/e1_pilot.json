{
  "schema_version": 1,
  "name": "e1-synthetic-pilot",
  "purpose": "development",
  "energy_parameter_file": "params/rna_Turner04.par",
  "model_settings": {
    "temperature_celsius": 37,
    "temperature_source": "CLI/API default; verify RT metadata",
    "build_revision_verified": false
  },
  "environment": {
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "LC_ALL": "C"
  },
  "timeout_seconds": 60,
  "warmups": 0,
  "repetitions": 1,
  "inputs": [
    {
      "name": "n40_r0_empty",
      "path": "data/pilot-v1/n40_r0_empty.txt"
    },
    {
      "name": "n40_r0_single",
      "path": "data/pilot-v1/n40_r0_single.txt"
    },
    {
      "name": "n40_r0_branched",
      "path": "data/pilot-v1/n40_r0_branched.txt"
    },
    {
      "name": "n40_r1_empty",
      "path": "data/pilot-v1/n40_r1_empty.txt"
    },
    {
      "name": "n40_r1_single",
      "path": "data/pilot-v1/n40_r1_single.txt"
    },
    {
      "name": "n40_r1_branched",
      "path": "data/pilot-v1/n40_r1_branched.txt"
    },
    {
      "name": "n80_r0_empty",
      "path": "data/pilot-v1/n80_r0_empty.txt"
    },
    {
      "name": "n80_r0_single",
      "path": "data/pilot-v1/n80_r0_single.txt"
    },
    {
      "name": "n80_r0_branched",
      "path": "data/pilot-v1/n80_r0_branched.txt"
    },
    {
      "name": "n80_r1_empty",
      "path": "data/pilot-v1/n80_r1_empty.txt"
    },
    {
      "name": "n80_r1_single",
      "path": "data/pilot-v1/n80_r1_single.txt"
    },
    {
      "name": "n80_r1_branched",
      "path": "data/pilot-v1/n80_r1_branched.txt"
    },
    {
      "name": "n160_r0_empty",
      "path": "data/pilot-v1/n160_r0_empty.txt"
    },
    {
      "name": "n160_r0_single",
      "path": "data/pilot-v1/n160_r0_single.txt"
    },
    {
      "name": "n160_r0_branched",
      "path": "data/pilot-v1/n160_r0_branched.txt"
    },
    {
      "name": "n160_r1_empty",
      "path": "data/pilot-v1/n160_r1_empty.txt"
    },
    {
      "name": "n160_r1_single",
      "path": "data/pilot-v1/n160_r1_single.txt"
    },
    {
      "name": "n160_r1_branched",
      "path": "data/pilot-v1/n160_r1_branched.txt"
    }
  ],
  "modes": [
    {
      "name": "exact",
      "args": [
        "--exact"
      ]
    },
    {
      "name": "beam20_nocap",
      "args": [
        "-b",
        "20",
        "--max-hairpin",
        "1000000",
        "--max-case3-depth",
        "1000000"
      ]
    },
    {
      "name": "beam50_nocap",
      "args": [
        "-b",
        "50",
        "--max-hairpin",
        "1000000",
        "--max-case3-depth",
        "1000000"
      ]
    },
    {
      "name": "beam100_nocap",
      "args": [
        "-b",
        "100",
        "--max-hairpin",
        "1000000",
        "--max-case3-depth",
        "1000000"
      ]
    },
    {
      "name": "beam200_nocap",
      "args": [
        "-b",
        "200",
        "--max-hairpin",
        "1000000",
        "--max-case3-depth",
        "1000000"
      ]
    },
    {
      "name": "beam100_default",
      "args": [
        "-b",
        "100",
        "--max-hairpin",
        "30",
        "--max-case3-depth",
        "30"
      ]
    }
  ],
  "programs": [
    {
      "name": "LinearCParty",
      "args": [
        "--bpp-cutoff",
        "0"
      ],
      "outputs": [
        {
          "name": "bpp.tsv",
          "flag": "--bpp"
        }
      ]
    },
    {
      "name": "LinearPKCapR",
      "args": []
    },
    {
      "name": "LinearPKRaccess",
      "args": [
        "--access-len",
        "1,4,8,16",
        "--probability"
      ]
    }
  ],
  "analysis": {
    "reference_mode": "exact",
    "default_cap_comparison": "Finite-beam setting sensitivity; not an isolated cap-only error decomposition."
  }
}
